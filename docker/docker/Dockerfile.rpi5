###############################################################################
# Dockerfile.rpi5 — Raspberry Pi 5 (arm64, no GPU)
#
# Lightweight onboard compute image: ROS2 base, PX4 msgs, XRCE-DDS.
# No CUDA, no GUI — designed for headless companion-computer operation.
#
# Build (on the Pi, or cross-build from amd64):
#   docker buildx bake rpi5              (preferred)
#   — or on the Pi —
#   docker build -f docker/Dockerfile.rpi5 -t rpi5:latest .
###############################################################################
ARG RPI_BASE_IMAGE=ros:humble-ros-base-jammy
FROM ${RPI_BASE_IMAGE} AS rpi5

ARG ROS_DISTRO=humble
ARG XRCE_DDS_VERSION=v2.4.3
ARG PX4_MSGS_BRANCH=main
ARG PX4_ROS_COM_BRANCH=main

ENV DEBIAN_FRONTEND=noninteractive \
    TZ=UTC

# ── System packages (keep minimal for Pi) ────────────────────────────────────
RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential cmake git wget curl ca-certificates \
        python3-pip python3-colcon-common-extensions python3-rosdep \
        python3-vcstool python3-jinja2 python3-numpy python3-empy \
        python3-toml python3-packaging python3-jsonschema \
        tmux htop nano net-tools iputils-ping iproute2 \
        # Serial / UART for PX4 connection
        python3-serial \
    && rm -rf /var/lib/apt/lists/*

# ── ROS2 packages ───────────────────────────────────────────────────────────
RUN apt-get update && apt-get install -y --no-install-recommends \
        ros-${ROS_DISTRO}-rmw-cyclonedds-cpp \
        ros-${ROS_DISTRO}-rmw-fastrtps-cpp \
        ros-${ROS_DISTRO}-geographic-msgs \
        ros-${ROS_DISTRO}-tf2-ros \
        ros-${ROS_DISTRO}-tf2-geometry-msgs \
        ros-${ROS_DISTRO}-diagnostic-updater \
        ros-${ROS_DISTRO}-robot-localization \
        ros-${ROS_DISTRO}-launch-testing-ament-cmake \
    && rm -rf /var/lib/apt/lists/*

# ── Micro-XRCE-DDS Agent ────────────────────────────────────────────────────
RUN git clone --depth 1 --branch ${XRCE_DDS_VERSION} \
        https://github.com/eProsima/Micro-XRCE-DDS-Agent.git /tmp/xrce \
    && cd /tmp/xrce && mkdir build && cd build \
    && cmake .. -DCMAKE_BUILD_TYPE=Release \
    && make -j$(nproc) && make install && ldconfig \
    && rm -rf /tmp/xrce

# ── px4_msgs + px4_ros_com ───────────────────────────────────────────────────
RUN mkdir -p /opt/px4_ws/src \
    && cd /opt/px4_ws/src \
    && git clone --depth 1 --branch ${PX4_MSGS_BRANCH} \
        https://github.com/PX4/px4_msgs.git \
    && git clone --depth 1 --branch ${PX4_ROS_COM_BRANCH} \
        https://github.com/PX4/px4_ros_com.git

RUN . /opt/ros/${ROS_DISTRO}/setup.sh \
    && cd /opt/px4_ws \
    && colcon build --symlink-install \
        --cmake-args -DCMAKE_BUILD_TYPE=Release \
        --event-handlers console_direct+

# ── Python tooling ──────────────────────────────────────────────────────────
RUN pip3 install --no-cache-dir \
        mavsdk pymavlink "setuptools==58.2.0"

# ── User workspace ──────────────────────────────────────────────────────────
RUN mkdir -p /ros2_ws/src

# ── Config & entrypoint ─────────────────────────────────────────────────────
COPY config/entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh
COPY config/cyclonedds.xml /config/cyclonedds.xml

ENV RMW_IMPLEMENTATION=rmw_cyclonedds_cpp \
    CYCLONEDDS_URI=/config/cyclonedds.xml

RUN { \
    echo 'source /opt/ros/${ROS_DISTRO}/setup.bash'; \
    echo 'source /opt/px4_ws/install/setup.bash'; \
    echo '[ -f /ros2_ws/install/setup.bash ] && source /ros2_ws/install/setup.bash'; \
    echo 'export ROS_DOMAIN_ID=${DRONE_ID:-0}'; \
} >> /root/.bashrc

WORKDIR /ros2_ws
ENTRYPOINT ["/entrypoint.sh"]
CMD ["bash"]
