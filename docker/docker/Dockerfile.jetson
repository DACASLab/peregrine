###############################################################################
# Dockerfile.jetson — NVIDIA Jetson Orin Nano / Orin NX (JetPack 6.x)
#
# Onboard compute image with CUDA, cuDNN, TensorRT already in base.
# ROS2 is installed from apt (Ubuntu 22.04 in JetPack 6.x).
#
# IMPORTANT:
#   - Build this ON the Jetson (native arm64), or cross-build with buildx.
#   - Requires JetPack 6.0+ and NVIDIA Container Toolkit on the host.
#   - Set default runtime to nvidia: /etc/docker/daemon.json →
#     { "runtimes": { "nvidia": { ... } }, "default-runtime": "nvidia" }
#
# Build:
#   docker buildx bake jetson                     (preferred)
#   — or on the Jetson itself —
#   docker build -f docker/Dockerfile.jetson -t jetson:latest .
###############################################################################
ARG JETSON_BASE_IMAGE=nvcr.io/nvidia/l4t-jetpack:r36.4.0
FROM ${JETSON_BASE_IMAGE} AS jetson

ARG ROS_DISTRO=humble
ARG ROS_WS=/ros2_ws
ARG CONTAINER_USER=peregrine
ARG USER_UID=1000
ARG USER_GID=1000

ENV DEBIAN_FRONTEND=noninteractive \
    TZ=UTC \
    ROS_DISTRO=${ROS_DISTRO} \
    LANG=en_US.UTF-8 \
    ROS_WS=${ROS_WS} \
    CONTAINER_USER=${CONTAINER_USER}

# ── Locale ───────────────────────────────────────────────────────────────────
RUN apt-get update && apt-get install -y locales \
    && locale-gen en_US.UTF-8 && update-locale LC_ALL=en_US.UTF-8

# ── ROS2 apt repo (arm64 / jammy) ───────────────────────────────────────────
RUN apt-get update && apt-get install -y --no-install-recommends \
        software-properties-common curl gnupg2 lsb-release ca-certificates \
    && add-apt-repository universe \
    && curl -sSL https://raw.githubusercontent.com/ros/rosdistro/master/ros.key \
        -o /usr/share/keyrings/ros-archive-keyring.gpg \
    && echo "deb [arch=$(dpkg --print-architecture) signed-by=/usr/share/keyrings/ros-archive-keyring.gpg] \
        http://packages.ros.org/ros2/ubuntu $(lsb_release -cs) main" \
        > /etc/apt/sources.list.d/ros2.list \
    && rm -rf /var/lib/apt/lists/*

# ── System + ROS2 base ──────────────────────────────────────────────────────
# We use ros-base (not desktop) to keep the image smaller on the Jetson.
# Add ros-${ROS_DISTRO}-rviz2 etc. below if you want GUI on Jetson.
RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential cmake git wget \
        python3-pip python3-colcon-common-extensions python3-rosdep \
        python3-vcstool python3-jinja2 python3-numpy python3-empy \
        python3-toml python3-packaging python3-jsonschema \
        tmux htop nano net-tools iputils-ping iproute2 sudo \
        bash-completion ruby-full \
        # ROS2 base + key packages
        ros-${ROS_DISTRO}-ros-base \
        ros-${ROS_DISTRO}-rmw-cyclonedds-cpp \
        ros-${ROS_DISTRO}-rmw-fastrtps-cpp \
        ros-${ROS_DISTRO}-geographic-msgs \
        ros-${ROS_DISTRO}-tf2-ros \
        ros-${ROS_DISTRO}-tf2-geometry-msgs \
        ros-${ROS_DISTRO}-eigen3-cmake-module \
        ros-${ROS_DISTRO}-diagnostic-updater \
        ros-${ROS_DISTRO}-robot-localization \
        ros-${ROS_DISTRO}-image-transport \
        ros-${ROS_DISTRO}-cv-bridge \
        ros-${ROS_DISTRO}-vision-opencv \
        ros-${ROS_DISTRO}-launch-testing-ament-cmake \
        # Camera pipeline (CSI / USB)
        ros-${ROS_DISTRO}-image-transport-plugins \
        ros-${ROS_DISTRO}-v4l2-camera \
        # GStreamer for camera integration
        gstreamer1.0-tools \
        gstreamer1.0-plugins-base \
        gstreamer1.0-plugins-good \
        libgstreamer1.0-dev \
    && rm -rf /var/lib/apt/lists/*

# ── Micro-XRCE-DDS Agent ────────────────────────────────────────────────────
RUN git clone --depth 1 https://github.com/eProsima/Micro-XRCE-DDS-Agent.git /tmp/xrce \
    && cd /tmp/xrce && mkdir build && cd build \
    && cmake .. -DCMAKE_BUILD_TYPE=Release \
    && make -j$(nproc) && make install && ldconfig \
    && rm -rf /tmp/xrce

RUN rosdep init 2>/dev/null || true

# ── Python / ML tooling ─────────────────────────────────────────────────────
# NOTE: The L4T base already has CUDA, cuDNN, TensorRT.
# Add your ML framework here (onnxruntime-gpu, torch, ultralytics, etc.)
# Example for YOLO + ONNX GPU inference (uncomment when needed):
#
# RUN pip3 install --no-cache-dir \
#         onnxruntime-gpu ultralytics
#
RUN pip3 install --no-cache-dir \
        mavsdk pymavlink "setuptools==58.2.0"
RUN gem install tmuxinator --no-document
RUN curl -fsSL https://starship.rs/install.sh | sh -s -- -y
COPY config/tmuxinator/peregrine.yml /tmp/peregrine-tmuxinator.yml
COPY config/tmuxinator/flight.yml /tmp/flight-tmuxinator.yml
COPY config/starship.toml /tmp/starship.toml

# ── Create non-root development user (host UID/GID mapping) ────────────────
RUN set -eux; \
    if getent passwd ubuntu > /dev/null 2>&1; then userdel -r ubuntu; fi; \
    if getent passwd "${CONTAINER_USER}" > /dev/null 2>&1; then userdel -r "${CONTAINER_USER}"; fi; \
    if getent passwd "${USER_UID}" > /dev/null 2>&1; then \
      EXISTING_UID_USER="$(getent passwd "${USER_UID}" | cut -d: -f1)"; \
      userdel -r "${EXISTING_UID_USER}" || true; \
    fi; \
    if ! getent group "${USER_GID}" > /dev/null 2>&1; then groupadd --gid "${USER_GID}" "${CONTAINER_USER}"; fi; \
    useradd -s /bin/bash --uid "${USER_UID}" --gid "${USER_GID}" -m "${CONTAINER_USER}"; \
    EXTRA_GROUPS=""; \
    for grp in sudo dialout video plugdev input; do \
      if getent group "${grp}" > /dev/null 2>&1; then \
        EXTRA_GROUPS="${EXTRA_GROUPS}${EXTRA_GROUPS:+,}${grp}"; \
      fi; \
    done; \
    if [ -n "${EXTRA_GROUPS}" ]; then usermod -aG "${EXTRA_GROUPS}" "${CONTAINER_USER}"; fi; \
    echo "${CONTAINER_USER} ALL=(ALL) NOPASSWD:ALL" > "/etc/sudoers.d/${CONTAINER_USER}"; \
    chmod 0440 "/etc/sudoers.d/${CONTAINER_USER}"; \
    mkdir -p "${ROS_WS}/src"; \
    mkdir -p "/home/${CONTAINER_USER}/.config/tmuxinator"; \
    cp /tmp/peregrine-tmuxinator.yml "/home/${CONTAINER_USER}/.config/tmuxinator/peregrine.yml"; \
    cp /tmp/flight-tmuxinator.yml "/home/${CONTAINER_USER}/.config/tmuxinator/flight.yml"; \
    cp /tmp/starship.toml "/home/${CONTAINER_USER}/.config/starship.toml"; \
    chown -R "${USER_UID}:${USER_GID}" "${ROS_WS}" "/home/${CONTAINER_USER}"

# ── Config & entrypoint ─────────────────────────────────────────────────────
COPY config/entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

RUN { \
    echo 'source /opt/ros/${ROS_DISTRO}/setup.bash'; \
    echo '[ -f /usr/share/colcon_argcomplete/hook/colcon-argcomplete.bash ] && source /usr/share/colcon_argcomplete/hook/colcon-argcomplete.bash'; \
    echo '[ -f ${ROS_WS}/install/setup.bash ] && source ${ROS_WS}/install/setup.bash'; \
    echo 'export PATH="$HOME/.local/bin:$PATH"'; \
    echo 'if command -v starship >/dev/null 2>&1; then eval "$(starship init bash)"; fi'; \
    echo 'export ROS_DOMAIN_ID=${DRONE_ID:-0}'; \
} >> /home/${CONTAINER_USER}/.bashrc

USER ${CONTAINER_USER}
WORKDIR ${ROS_WS}
ENTRYPOINT ["/entrypoint.sh"]
CMD ["bash"]
