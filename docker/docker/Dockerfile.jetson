###############################################################################
# Dockerfile.jetson — NVIDIA Jetson Orin Nano / Orin NX (JetPack 6.x)
#
# Onboard compute image with CUDA, cuDNN, TensorRT already in base.
# ROS2 is installed from apt (Ubuntu 22.04 in JetPack 6.x).
#
# IMPORTANT:
#   - Build this ON the Jetson (native arm64), or cross-build with buildx.
#   - Requires JetPack 6.0+ and NVIDIA Container Toolkit on the host.
#   - Set default runtime to nvidia: /etc/docker/daemon.json →
#     { "runtimes": { "nvidia": { ... } }, "default-runtime": "nvidia" }
#
# Build:
#   docker buildx bake jetson                     (preferred)
#   — or on the Jetson itself —
#   docker build -f docker/Dockerfile.jetson -t jetson:latest .
###############################################################################
ARG JETSON_BASE_IMAGE=nvcr.io/nvidia/l4t-jetpack:r36.4.0
FROM ${JETSON_BASE_IMAGE} AS jetson

ARG ROS_DISTRO=humble
ARG XRCE_DDS_VERSION=v2.4.3
ARG PX4_MSGS_BRANCH=main
ARG PX4_ROS_COM_BRANCH=main

ENV DEBIAN_FRONTEND=noninteractive \
    TZ=UTC \
    ROS_DISTRO=${ROS_DISTRO} \
    LANG=en_US.UTF-8

# ── Locale ───────────────────────────────────────────────────────────────────
RUN apt-get update && apt-get install -y locales \
    && locale-gen en_US.UTF-8 && update-locale LC_ALL=en_US.UTF-8

# ── ROS2 apt repo (arm64 / jammy) ───────────────────────────────────────────
RUN apt-get update && apt-get install -y --no-install-recommends \
        software-properties-common curl gnupg2 lsb-release ca-certificates \
    && add-apt-repository universe \
    && curl -sSL https://raw.githubusercontent.com/ros/rosdistro/master/ros.key \
        -o /usr/share/keyrings/ros-archive-keyring.gpg \
    && echo "deb [arch=$(dpkg --print-architecture) signed-by=/usr/share/keyrings/ros-archive-keyring.gpg] \
        http://packages.ros.org/ros2/ubuntu $(lsb_release -cs) main" \
        > /etc/apt/sources.list.d/ros2.list \
    && rm -rf /var/lib/apt/lists/*

# ── System + ROS2 base ──────────────────────────────────────────────────────
# We use ros-base (not desktop) to keep the image smaller on the Jetson.
# Add ros-${ROS_DISTRO}-rviz2 etc. below if you want GUI on Jetson.
RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential cmake git wget \
        python3-pip python3-colcon-common-extensions python3-rosdep \
        python3-vcstool python3-jinja2 python3-numpy python3-empy \
        python3-toml python3-packaging python3-jsonschema \
        tmux htop nano net-tools iputils-ping iproute2 \
        # ROS2 base + key packages
        ros-${ROS_DISTRO}-ros-base \
        ros-${ROS_DISTRO}-rmw-cyclonedds-cpp \
        ros-${ROS_DISTRO}-rmw-fastrtps-cpp \
        ros-${ROS_DISTRO}-geographic-msgs \
        ros-${ROS_DISTRO}-tf2-ros \
        ros-${ROS_DISTRO}-tf2-geometry-msgs \
        ros-${ROS_DISTRO}-eigen3-cmake-module \
        ros-${ROS_DISTRO}-diagnostic-updater \
        ros-${ROS_DISTRO}-robot-localization \
        ros-${ROS_DISTRO}-image-transport \
        ros-${ROS_DISTRO}-cv-bridge \
        ros-${ROS_DISTRO}-vision-opencv \
        ros-${ROS_DISTRO}-launch-testing-ament-cmake \
        # Camera pipeline (CSI / USB)
        ros-${ROS_DISTRO}-image-transport-plugins \
        ros-${ROS_DISTRO}-v4l2-camera \
        # GStreamer for camera integration
        gstreamer1.0-tools \
        gstreamer1.0-plugins-base \
        gstreamer1.0-plugins-good \
        libgstreamer1.0-dev \
    && rm -rf /var/lib/apt/lists/*

# ── Micro-XRCE-DDS Agent ────────────────────────────────────────────────────
RUN git clone --depth 1 --branch ${XRCE_DDS_VERSION} \
        https://github.com/eProsima/Micro-XRCE-DDS-Agent.git /tmp/xrce \
    && cd /tmp/xrce && mkdir build && cd build \
    && cmake .. -DCMAKE_BUILD_TYPE=Release \
    && make -j$(nproc) && make install && ldconfig \
    && rm -rf /tmp/xrce

# ── px4_msgs + px4_ros_com ───────────────────────────────────────────────────
RUN mkdir -p /opt/px4_ws/src \
    && cd /opt/px4_ws/src \
    && git clone --depth 1 --branch ${PX4_MSGS_BRANCH} \
        https://github.com/PX4/px4_msgs.git \
    && git clone --depth 1 --branch ${PX4_ROS_COM_BRANCH} \
        https://github.com/PX4/px4_ros_com.git

RUN . /opt/ros/${ROS_DISTRO}/setup.sh \
    && cd /opt/px4_ws \
    && colcon build --symlink-install \
        --cmake-args -DCMAKE_BUILD_TYPE=Release \
        --event-handlers console_direct+

# ── Python / ML tooling ─────────────────────────────────────────────────────
# NOTE: The L4T base already has CUDA, cuDNN, TensorRT.
# Add your ML framework here (onnxruntime-gpu, torch, ultralytics, etc.)
# Example for YOLO + ONNX GPU inference (uncomment when needed):
#
# RUN pip3 install --no-cache-dir \
#         onnxruntime-gpu ultralytics
#
RUN pip3 install --no-cache-dir \
        mavsdk pymavlink "setuptools==58.2.0"

# ── User workspace ──────────────────────────────────────────────────────────
RUN mkdir -p /ros2_ws/src

# ── Config & entrypoint ─────────────────────────────────────────────────────
COPY config/entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh
COPY config/cyclonedds.xml /config/cyclonedds.xml

ENV RMW_IMPLEMENTATION=rmw_cyclonedds_cpp \
    CYCLONEDDS_URI=/config/cyclonedds.xml

RUN { \
    echo 'source /opt/ros/${ROS_DISTRO}/setup.bash'; \
    echo 'source /opt/px4_ws/install/setup.bash'; \
    echo '[ -f /ros2_ws/install/setup.bash ] && source /ros2_ws/install/setup.bash'; \
    echo 'export ROS_DOMAIN_ID=${DRONE_ID:-0}'; \
} >> /root/.bashrc

WORKDIR /ros2_ws
ENTRYPOINT ["/entrypoint.sh"]
CMD ["bash"]
