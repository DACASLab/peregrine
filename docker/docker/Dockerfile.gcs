###############################################################################
# Dockerfile.gcs — Ground Control Station (amd64, no CUDA)
#
# Lightweight GCS image: ROS2 base + RViz + Zenoh bridge.
# No PX4, Gazebo, CUDA, or XRCE agent — only visualization and monitoring.
#
# Build:
#   docker compose -f compose/docker-compose.gcs.yml build
###############################################################################
ARG RPI_BASE_IMAGE=ros:humble-ros-base-jammy
FROM ${RPI_BASE_IMAGE} AS gcs

ARG ROS_DISTRO=humble
ARG ROS_WS=/ros2_ws
ARG CONTAINER_USER=peregrine
ARG USER_UID=1000
ARG USER_GID=1000

ENV DEBIAN_FRONTEND=noninteractive \
    TZ=UTC \
    ROS_DISTRO=${ROS_DISTRO} \
    LANG=en_US.UTF-8 \
    ROS_WS=${ROS_WS} \
    CONTAINER_USER=${CONTAINER_USER}

# ── Locale ───────────────────────────────────────────────────────────────────
RUN apt-get update && apt-get install -y locales \
    && locale-gen en_US.UTF-8 && update-locale LC_ALL=en_US.UTF-8

# ── System packages ─────────────────────────────────────────────────────────
RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential cmake git wget curl ca-certificates \
        python3-pip python3-colcon-common-extensions python3-rosdep \
        python3-vcstool python3-jinja2 python3-numpy python3-empy \
        python3-toml python3-packaging python3-jsonschema \
        tmux htop nano net-tools iputils-ping iproute2 sudo \
        bash-completion ruby-full \
    && rm -rf /var/lib/apt/lists/*

# ── ROS2 packages (base + RViz for visualization) ───────────────────────────
RUN apt-get update && apt-get install -y --no-install-recommends \
        ros-${ROS_DISTRO}-rmw-cyclonedds-cpp \
        ros-${ROS_DISTRO}-rmw-fastrtps-cpp \
        ros-${ROS_DISTRO}-geographic-msgs \
        ros-${ROS_DISTRO}-tf2-ros \
        ros-${ROS_DISTRO}-tf2-geometry-msgs \
        ros-${ROS_DISTRO}-eigen3-cmake-module \
        ros-${ROS_DISTRO}-diagnostic-updater \
        ros-${ROS_DISTRO}-robot-localization \
        ros-${ROS_DISTRO}-launch-testing-ament-cmake \
        ros-${ROS_DISTRO}-rviz2 \
        ros-${ROS_DISTRO}-rviz-common \
        ros-${ROS_DISTRO}-rviz-default-plugins \
    && rm -rf /var/lib/apt/lists/*

# ── Zenoh bridge for ROS2 DDS ───────────────────────────────────────────────
RUN curl -fsSL https://download.eclipse.org/zenoh/debian-repo/zenoh-public-key \
        | gpg --dearmor --yes --output /etc/apt/keyrings/zenoh-public-key.gpg \
    && echo "deb [signed-by=/etc/apt/keyrings/zenoh-public-key.gpg] https://download.eclipse.org/zenoh/debian-repo/ /" \
        > /etc/apt/sources.list.d/zenoh.list \
    && apt-get update \
    && apt-get install -y --no-install-recommends zenoh-bridge-ros2dds \
    && rm -rf /var/lib/apt/lists/*

RUN rosdep init 2>/dev/null || true

# ── Python tooling ──────────────────────────────────────────────────────────
RUN pip3 install --no-cache-dir "setuptools==58.2.0"
RUN gem install tmuxinator --no-document
RUN curl -fsSL https://starship.rs/install.sh | sh -s -- -y
COPY config/tmuxinator/peregrine.yml /tmp/peregrine-tmuxinator.yml
COPY config/starship.toml /tmp/starship.toml

# ── Create non-root development user (host UID/GID mapping) ────────────────
RUN set -eux; \
    if getent passwd ubuntu > /dev/null 2>&1; then userdel -r ubuntu; fi; \
    if getent passwd "${CONTAINER_USER}" > /dev/null 2>&1; then userdel -r "${CONTAINER_USER}"; fi; \
    if getent passwd "${USER_UID}" > /dev/null 2>&1; then \
      EXISTING_UID_USER="$(getent passwd "${USER_UID}" | cut -d: -f1)"; \
      userdel -r "${EXISTING_UID_USER}" || true; \
    fi; \
    if ! getent group "${USER_GID}" > /dev/null 2>&1; then groupadd --gid "${USER_GID}" "${CONTAINER_USER}"; fi; \
    useradd -s /bin/bash --uid "${USER_UID}" --gid "${USER_GID}" -m "${CONTAINER_USER}"; \
    EXTRA_GROUPS=""; \
    for grp in sudo dialout video plugdev input; do \
      if getent group "${grp}" > /dev/null 2>&1; then \
        EXTRA_GROUPS="${EXTRA_GROUPS}${EXTRA_GROUPS:+,}${grp}"; \
      fi; \
    done; \
    if [ -n "${EXTRA_GROUPS}" ]; then usermod -aG "${EXTRA_GROUPS}" "${CONTAINER_USER}"; fi; \
    echo "${CONTAINER_USER} ALL=(ALL) NOPASSWD:ALL" > "/etc/sudoers.d/${CONTAINER_USER}"; \
    chmod 0440 "/etc/sudoers.d/${CONTAINER_USER}"; \
    mkdir -p "${ROS_WS}/src"; \
    mkdir -p "/home/${CONTAINER_USER}/.config/tmuxinator"; \
    cp /tmp/peregrine-tmuxinator.yml "/home/${CONTAINER_USER}/.config/tmuxinator/peregrine.yml"; \
    cp /tmp/starship.toml "/home/${CONTAINER_USER}/.config/starship.toml"; \
    chown -R "${USER_UID}:${USER_GID}" "${ROS_WS}" "/home/${CONTAINER_USER}"

# ── Config & entrypoint ─────────────────────────────────────────────────────
COPY config/entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

RUN { \
    echo 'source /opt/ros/${ROS_DISTRO}/setup.bash'; \
    echo '[ -f /usr/share/colcon_argcomplete/hook/colcon-argcomplete.bash ] && source /usr/share/colcon_argcomplete/hook/colcon-argcomplete.bash'; \
    echo '[ -f ${ROS_WS}/install/setup.bash ] && source ${ROS_WS}/install/setup.bash'; \
    echo 'export PATH="$HOME/.local/bin:$PATH"'; \
    echo 'if command -v starship >/dev/null 2>&1; then eval "$(starship init bash)"; fi'; \
    echo 'export ROS_DOMAIN_ID=${DRONE_ID:-0}'; \
} >> /home/${CONTAINER_USER}/.bashrc

# ── BehaviorTree.CPP v4 (Phase 7: BT package scaffolding) ───────────────────
RUN apt-get update && apt-get install -y --no-install-recommends \
    ros-${ROS_DISTRO}-behaviortree-cpp \
    ros-${ROS_DISTRO}-generate-parameter-library \
    libncurses-dev \
    && rm -rf /var/lib/apt/lists/*

USER ${CONTAINER_USER}
WORKDIR ${ROS_WS}
ENTRYPOINT ["/entrypoint.sh"]
CMD ["bash"]
