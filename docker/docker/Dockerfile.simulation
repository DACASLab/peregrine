###############################################################################
# Dockerfile.simulation — Desktop PC with NVIDIA GPU
#
# Adds: Gazebo Harmonic, PX4 SITL, ROS2 desktop GUI tools, GPU rendering.
# Base image is NVIDIA CUDA so we get OpenGL + CUDA out of the box.
#
# Build:
#   docker buildx bake simulation        (preferred)
#   — or —
#   docker build -f docker/Dockerfile.simulation -t sim:latest .
###############################################################################
ARG SIM_BASE_IMAGE=nvcr.io/nvidia/cuda:12.8.1-cudnn-runtime-ubuntu22.04
FROM ${SIM_BASE_IMAGE} AS simulation

ARG ROS_DISTRO=humble
ARG XRCE_DDS_VERSION=v2.4.3
ARG PX4_VERSION=v1.15.4
ARG PX4_MSGS_BRANCH=main
ARG PX4_ROS_COM_BRANCH=main
ARG ROS_WS=/ros2_ws
ARG CONTAINER_USER=peregrine
ARG USER_UID=1000
ARG USER_GID=1000

ENV DEBIAN_FRONTEND=noninteractive \
    TZ=UTC \
    ROS_DISTRO=${ROS_DISTRO} \
    LANG=en_US.UTF-8 \
    ROS_WS=${ROS_WS} \
    CONTAINER_USER=${CONTAINER_USER}

# ── Locale ───────────────────────────────────────────────────────────────────
RUN apt-get update && apt-get install -y locales \
    && locale-gen en_US.UTF-8 && update-locale LC_ALL=en_US.UTF-8

# ── ROS2 apt repository ─────────────────────────────────────────────────────
RUN apt-get update && apt-get install -y --no-install-recommends \
        software-properties-common curl gnupg2 lsb-release ca-certificates \
    && add-apt-repository universe \
    && curl -sSL https://raw.githubusercontent.com/ros/rosdistro/master/ros.key \
        -o /usr/share/keyrings/ros-archive-keyring.gpg \
    && echo "deb [arch=$(dpkg --print-architecture) signed-by=/usr/share/keyrings/ros-archive-keyring.gpg] \
        http://packages.ros.org/ros2/ubuntu $(lsb_release -cs) main" \
        > /etc/apt/sources.list.d/ros2.list \
    && rm -rf /var/lib/apt/lists/*

# ── System + ROS2 desktop-full ───────────────────────────────────────────────
RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential cmake git wget \
        python3-pip python3-colcon-common-extensions python3-rosdep \
        python3-vcstool python3-jinja2 python3-numpy python3-empy \
        python3-toml python3-packaging python3-jsonschema \
        tmux htop nano net-tools iputils-ping iproute2 gdb sudo \
        bash-completion ruby-full \
        # Display / GUI
        mesa-utils libgl1-mesa-dri libglx-mesa0 libglu1-mesa-dev \
        xauth x11-xserver-utils dbus-x11 \
        # ROS2 desktop-full
        ros-${ROS_DISTRO}-desktop-full \
        ros-${ROS_DISTRO}-rmw-cyclonedds-cpp \
        ros-${ROS_DISTRO}-rmw-fastrtps-cpp \
        ros-${ROS_DISTRO}-geographic-msgs \
        ros-${ROS_DISTRO}-tf2-ros \
        ros-${ROS_DISTRO}-tf2-geometry-msgs \
        ros-${ROS_DISTRO}-eigen3-cmake-module \
        ros-${ROS_DISTRO}-diagnostic-updater \
        ros-${ROS_DISTRO}-robot-localization \
        ros-${ROS_DISTRO}-image-transport \
        ros-${ROS_DISTRO}-cv-bridge \
        ros-${ROS_DISTRO}-vision-opencv \
        ros-${ROS_DISTRO}-plotjuggler-ros \
        ros-${ROS_DISTRO}-launch-testing-ament-cmake \
    && rm -rf /var/lib/apt/lists/*

# ── Gazebo Harmonic ──────────────────────────────────────────────────────────
RUN wget https://packages.osrfoundation.org/gazebo.gpg \
        -O /usr/share/keyrings/pkgs-osrf-archive-keyring.gpg \
    && echo "deb [arch=$(dpkg --print-architecture) \
        signed-by=/usr/share/keyrings/pkgs-osrf-archive-keyring.gpg] \
        http://packages.osrfoundation.org/gazebo/ubuntu-stable \
        $(lsb_release -cs) main" \
        > /etc/apt/sources.list.d/gazebo-stable.list \
    && apt-get update && apt-get install -y --no-install-recommends \
        gz-harmonic \
    && rm -rf /var/lib/apt/lists/*

# ROS2 ↔ Gazebo bridge
RUN apt-get update && apt-get install -y --no-install-recommends \
        ros-${ROS_DISTRO}-ros-gzharmonic \
    && rm -rf /var/lib/apt/lists/*

# ── Micro-XRCE-DDS Agent ────────────────────────────────────────────────────
RUN git clone --depth 1 --branch ${XRCE_DDS_VERSION} \
        https://github.com/eProsima/Micro-XRCE-DDS-Agent.git /tmp/xrce \
    && cd /tmp/xrce && mkdir build && cd build \
    && cmake .. -DCMAKE_BUILD_TYPE=Release \
    && make -j$(nproc) && make install && ldconfig \
    && rm -rf /tmp/xrce

# ── PX4 Autopilot (SITL) ────────────────────────────────────────────────────
RUN git clone --depth 1 --branch ${PX4_VERSION} --recursive \
        https://github.com/PX4/PX4-Autopilot.git /opt/PX4-Autopilot

RUN cd /opt/PX4-Autopilot \
    && bash ./Tools/setup/ubuntu.sh --no-nuttx --no-sim-tools \
    && rm -rf /var/lib/apt/lists/*

# Pre-build SITL target (big time saver on first run)
RUN cd /opt/PX4-Autopilot \
    && make px4_sitl \
    && rm -rf build/px4_sitl_default/tmp

# ── px4_msgs + px4_ros_com ───────────────────────────────────────────────────
RUN mkdir -p /opt/px4_ws/src \
    && cd /opt/px4_ws/src \
    && git clone --depth 1 --branch ${PX4_MSGS_BRANCH} \
        https://github.com/PX4/px4_msgs.git \
    && git clone --depth 1 --branch ${PX4_ROS_COM_BRANCH} \
        https://github.com/PX4/px4_ros_com.git

RUN . /opt/ros/${ROS_DISTRO}/setup.sh \
    && cd /opt/px4_ws \
    && colcon build --symlink-install \
        --cmake-args -DCMAKE_BUILD_TYPE=Release \
        --event-handlers console_direct+

RUN rosdep init 2>/dev/null || true

# ── Python tooling ──────────────────────────────────────────────────────────
RUN pip3 install --no-cache-dir \
        mavsdk pymavlink "setuptools==58.2.0"
RUN gem install tmuxinator --no-document
COPY config/tmuxinator/peregrine.yml /tmp/peregrine-tmuxinator.yml

# ── Create non-root development user (host UID/GID mapping) ────────────────
RUN set -eux; \
    if getent passwd ubuntu > /dev/null 2>&1; then userdel -r ubuntu; fi; \
    if getent passwd "${CONTAINER_USER}" > /dev/null 2>&1; then userdel -r "${CONTAINER_USER}"; fi; \
    if getent passwd "${USER_UID}" > /dev/null 2>&1; then \
      EXISTING_UID_USER="$(getent passwd "${USER_UID}" | cut -d: -f1)"; \
      userdel -r "${EXISTING_UID_USER}" || true; \
    fi; \
    if ! getent group "${USER_GID}" > /dev/null 2>&1; then groupadd --gid "${USER_GID}" "${CONTAINER_USER}"; fi; \
    useradd -s /bin/bash --uid "${USER_UID}" --gid "${USER_GID}" -m "${CONTAINER_USER}"; \
    usermod -aG sudo,dialout,video,plugdev,input "${CONTAINER_USER}"; \
    echo "${CONTAINER_USER} ALL=(ALL) NOPASSWD:ALL" > "/etc/sudoers.d/${CONTAINER_USER}"; \
    chmod 0440 "/etc/sudoers.d/${CONTAINER_USER}"; \
    mkdir -p "${ROS_WS}/src"; \
    mkdir -p "/home/${CONTAINER_USER}/.config/tmuxinator"; \
    cp /tmp/peregrine-tmuxinator.yml "/home/${CONTAINER_USER}/.config/tmuxinator/peregrine.yml"; \
    chown -R "${USER_UID}:${USER_GID}" "${ROS_WS}" "/home/${CONTAINER_USER}"

# ── Config & entrypoint ─────────────────────────────────────────────────────
COPY config/entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

# ── Environment ─────────────────────────────────────────────────────────────
ENV PX4_HOME=/opt/PX4-Autopilot \
    GZ_SIM_RESOURCE_PATH=/opt/PX4-Autopilot/Tools/simulation/gz/models:/opt/PX4-Autopilot/Tools/simulation/gz/worlds \
    NVIDIA_VISIBLE_DEVICES=all \
    NVIDIA_DRIVER_CAPABILITIES=graphics,utility,compute \
    QT_X11_NO_MITSHM=1

RUN { \
    echo 'source /opt/ros/${ROS_DISTRO}/setup.bash'; \
    echo '[ -f /usr/share/colcon_argcomplete/hook/colcon-argcomplete.bash ] && source /usr/share/colcon_argcomplete/hook/colcon-argcomplete.bash'; \
    echo 'source /opt/px4_ws/install/setup.bash'; \
    echo '[ -f ${ROS_WS}/install/setup.bash ] && source ${ROS_WS}/install/setup.bash'; \
    echo 'export ROS_DOMAIN_ID=${DRONE_ID:-0}'; \
} >> /home/${CONTAINER_USER}/.bashrc

USER ${CONTAINER_USER}
WORKDIR ${ROS_WS}
ENTRYPOINT ["/entrypoint.sh"]
CMD ["bash"]
