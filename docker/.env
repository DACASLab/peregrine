# ╔══════════════════════════════════════════════════════════════════════════════╗
# ║  ros2-px4-docker — Central Version Pins & Configuration                    ║
# ║  Edit this ONE file to upgrade any dependency across all images.            ║
# ╚══════════════════════════════════════════════════════════════════════════════╝

# ── Project ──────────────────────────────────────────────────────────────────
PROJECT_NAME=ros2-px4-flight
REGISTRY=ghcr.io/your-org      # Change to your registry

# ── ROS 2 ────────────────────────────────────────────────────────────────────
ROS_DISTRO=humble
# Options: humble (LTS→2027), jazzy (LTS→2029)
# When ready to migrate: change this + base images, rebuild.

# ── PX4 ──────────────────────────────────────────────────────────────────────
PX4_VERSION=v1.15.4
PX4_MSGS_BRANCH=main
PX4_ROS_COM_BRANCH=main

# ── Micro-XRCE-DDS Agent ────────────────────────────────────────────────────
XRCE_DDS_VERSION=v2.4.3

# ── Simulation (amd64 PC with NVIDIA GPU) ────────────────────────────────────
CUDA_VERSION=12.8.1
SIM_BASE_IMAGE=nvcr.io/nvidia/cuda:12.8.1-cudnn-runtime-ubuntu22.04
# Gazebo version is set by the apt repo (gz-harmonic for Humble)
PX4_SIM_MODEL=x500
PX4_GZ_WORLD=default

# ── Jetson (arm64 Orin Nano/NX, JetPack 6.x) ────────────────────────────────
JETSON_BASE_IMAGE=nvcr.io/nvidia/l4t-jetpack:r36.4.0
# r36.4.0 = JetPack 6.1, Ubuntu 22.04, CUDA 12.6, TensorRT 10.3

# ── RPi5 (arm64, no GPU) ────────────────────────────────────────────────────
RPI_BASE_IMAGE=ros:humble-ros-base-jammy

# ── Runtime defaults ─────────────────────────────────────────────────────────
DRONE_ID=1
XRCE_DDS_PORT=8888
HEADLESS=false
ROS_WS=/ros2_ws

# ── Container user mapping (for bind-mounted workspace ownership) ───────────
CONTAINER_USER=peregrine
USER_UID=1000
USER_GID=1000
