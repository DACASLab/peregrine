{
  // ── Per-UAV Zenoh Bridge Config ──────────────────────────────────────────
  // Bridges local DDS topics to Zenoh.
  //
  // Topic names are expected to already be UAV-scoped (for example /uav1/*)
  // by the ROS node namespaces in each UAV container.
  //
  // NOTE: This is a TEMPLATE. The entrypoint.sh replaces __DRONE_ID__ and
  // __ZENOH_PORT__ at runtime, writing to /tmp/zenoh_bridge.json5.
  //
  // Usage (via entrypoint, not directly):
  //   DRONE_ID=1 ZENOH_PORT=7447 zenoh-bridge-ros2dds -c /tmp/zenoh_bridge.json5

  mode: "peer",

  listen: {
    endpoints: ["tcp/0.0.0.0:__ZENOH_PORT__"],
  },

  connect: {
    endpoints: [],
  },

  plugins: {
    ros2dds: {
      domain: __DRONE_ID__,

      allow: {
        publishers: [
          ".*/uav_state",
          ".*/estimated_state",
          ".*/trajectory_setpoint",
          ".*/safety_status",
          ".*/estimation_status",
          ".*/control_status",
          ".*/trajectory_status",
          ".*/status",
          ".*/gps_status",
          "/tf",
          "tf",
          "/tf_static",
          "tf_static",
        ],
        subscribers: [],
        service_servers: [],
        service_clients: [],
        action_servers: [],
        action_clients: [],
      },
    },
  },
}
