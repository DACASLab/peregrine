{
  // ── Per-UAV Zenoh Bridge Config ──────────────────────────────────────────
  // Bridges local DDS topics to Zenoh.
  //
  // Topic names are expected to already be UAV-scoped (for example /uav2/*)
  // by the ROS node namespaces in each UAV container.
  //
  // NOTE: This is a TEMPLATE. The entrypoint.sh replaces __DRONE_ID__ and
  // __ZENOH_PORT__ at runtime, writing to /tmp/zenoh_bridge.json5.
  //
  // Usage (via entrypoint, not directly):
  //   DRONE_ID=2 ZENOH_PORT=7447 zenoh-bridge-ros2dds -c /tmp/zenoh_bridge.json5

  mode: "peer",

  listen: {
    endpoints: ["tcp/0.0.0.0:__ZENOH_PORT__"],
  },

  connect: {
    endpoints: [],
  },

  // Peer-to-peer discovery so UAVs see each other's /fleet/agent_state DIRECTLY
  // (decentralized BVC must not depend on the GCS relaying). Multicast works in
  // sim (host networking + loopback multicast) and on a shared field LAN. For
  // segmented hardware networks, list peer bridge endpoints in `connect` instead.
  scouting: {
    multicast: { enabled: true },
  },

  plugins: {
    ros2dds: {
      domain: __DRONE_ID__,
      ros_localhost_only: true,

      // Long-running BT missions (e.g. the surveillance sweep ~6 min) keep the
      // ExecuteTree action's get_result query pending well past the 300s plugin
      // default, which made the bridge reply Timeout and the GCS client report
      // FAILED even though the mission flew + landed successfully. Raise the
      // action result timeout to comfortably exceed the longest mission.
      queries_timeout: {
        actions: {
          get_result: 3600.0,
        },
      },

      allow: {
        publishers: [
          "/uav__DRONE_ID__/uav_state",
          "/uav__DRONE_ID__/estimated_state",
          "/uav__DRONE_ID__/trajectory_setpoint",
          "/uav__DRONE_ID__/safety_status",
          "/uav__DRONE_ID__/estimation_status",
          "/uav__DRONE_ID__/control_status",
          "/uav__DRONE_ID__/trajectory_status",
          "/uav__DRONE_ID__/status",
          "/uav__DRONE_ID__/gps_status",
          "/uav__DRONE_ID__/compute_status",
          // Inter-UAV collision avoidance: shared fleet bus. Every UAV publishes
          // its own FleetAgentState (uav_id is inside the message) to the SAME
          // global topic; Zenoh merges all peers' publications.
          "/fleet/agent_state",
          "/tf",
          "/tf_static",
        ],
        // Receive every peer's FleetAgentState on the same global topic. The local
        // multi_agent_coordinator filters out its own uav_id.
        subscribers: [
          "/fleet/agent_state",
        ],
        service_servers: [
          "/uav__DRONE_ID__/arm",
          "/uav__DRONE_ID__/uav_manager/clear_emergency",
        ],
        service_clients: [],
        action_servers: [
          "/uav__DRONE_ID__/uav_manager/takeoff",
          "/uav__DRONE_ID__/uav_manager/land",
          "/uav__DRONE_ID__/execute_tree",
        ],
        action_clients: [],
      },
    },
  },
}
